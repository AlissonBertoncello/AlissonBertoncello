# Copie este arquivo para .env e preencha com os SEUS dados.
# O .env guarda seus segredos e NUNCA deve ser compartilhado nem enviado ao GitHub.

# ── Mercado Livre (API oficial) ──────────────────────────────────────
# Crie um aplicativo em https://developers.mercadolivre.com.br/devcenter
# e copie o "App ID" (client_id) e a "Secret Key" (client_secret).
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Opcional: um access token já pronto (ex: gerado pelo fluxo OAuth com login).
# Se preenchido, é usado no lugar de gerar um token com client_id/secret.
ML_ACCESS_TOKEN=

# ── Mercado Livre Afiliados ──────────────────────────────────────────
# A "Etiqueta em uso" que aparece no Linkbuilder do painel de afiliados
# (https://www.mercadolivre.com.br/afiliados/linkbuilder)
ML_ETIQUETA=

# ── WhatsApp (Evolution API local, no Docker) ────────────────────────
# Senha da Evolution API: se ficar vazia, o bot gera uma sozinho no 1º uso.
EVOLUTION_API_KEY=
# Normalmente não precisa mudar:
EVOLUTION_URL=http://localhost:8080
EVOLUTION_INSTANCIA=bot-ofertas
